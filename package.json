{
  "name": "ai-roadmap",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "workspaces": ["client", "server", "shared"],
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vitest": "^4.1.12"
  }
}
